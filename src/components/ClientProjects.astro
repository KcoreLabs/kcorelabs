---
import { clientProjects } from '../config';
---
<div class="client-projects">
  {clientProjects.map((project, index) => (
    <article class:list={['client-project', `client-${project.id}`]}>
      <a class="client-cover" href={project.url} target="_blank" rel="noopener noreferrer" aria-label={`Visit ${project.name} website (opens in a new tab)`}>
        <span class="client-cover-top"><span>CLIENT PROJECT / 0{index + 1}</span><span aria-hidden="true">↗</span></span>
        <span class="client-cover-name">{project.name}</span>
        <span class="client-cover-bottom">{project.category}</span>
      </a>
      <div class="client-caption"><div><p class="eyebrow">Active client</p><h3>{project.name}</h3><p>{project.description}</p>{project.credit && <p class="client-credit">{project.credit}</p>}</div><a class="text-link" href={project.url} target="_blank" rel="noopener noreferrer">Visit website <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a></div>
    </article>
  ))}
</div>
