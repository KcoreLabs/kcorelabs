---
import Layout from "../layouts/Layout.astro";
import Closing from "../components/Closing.astro";
import { copy, enabledServices } from "../config";
---

<Layout title="Services" description={copy.services.intro}
  ><div class="wrap">
    <header class="page-intro">
      <p class="eyebrow">What I do</p><h1>{copy.services.title}</h1><p>
        {copy.services.intro}
      </p>
    </header>{
      enabledServices.map((s, i) => (
        <section class="detail-section" id={s.id}>
          <>
            <div>
              <>
                <p class="eyebrow">0{i + 1} / Services</p>
                <h2>{s.title}</h2>
                <p>{s.short}</p>
              </>
            </div>
            <div>
              <>
                <ul>
                  {s.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
                <p>{s.note}</p>
              </>
            </div>
          </>
        </section>
      ))
    }<div class="reading">
      <p>{copy.services.closing}</p><a class="text-link" href="/contact/"
        >Discuss your project ↗</a>
    </div>
  </div><Closing /></Layout
>
