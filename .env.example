# Build-time public Turnstile site key (never a secret).
PUBLIC_TURNSTILE_SITE_KEY=
# For local Worker testing only, copy the following to .dev.vars:
# LOCAL_TEST_MODE=true
# Production secrets: set each using npx wrangler secret put NAME
# RESEND_API_KEY: API key from your Resend account.
# CONTACT_FROM: verified sending identity, e.g. Kcore Labs <website@your-domain>.
# CONTACT_TO: real fixed recipient email address.
# TURNSTILE_SECRET_KEY: secret matching PUBLIC_TURNSTILE_SITE_KEY.
# SITE_ORIGIN and EMAIL_PROVIDER are configured in wrangler.jsonc.
